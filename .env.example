# =====================================================================
# Every setting the support workflow needs, and WHERE it goes.
#
#   [CREDENTIAL]  -> n8n: Credentials -> Add credential (encrypted by n8n)
#   [CONFIG]      -> the ⚙️ CONFIG node in workflows/support-dual-llm.json
#                    (and TURSO_DATABASE_URL / SLACK_CHANNEL_ID in the
#                    ⚙️ CONFIG node of workflows/error-handler.json)
#   [WIDGET]      -> chat-widget/widget.js (WEBHOOK_URL) or the <script> tag
#
# The workflow does NOT read environment variables. This file is a
# checklist; never commit a filled-in copy.
# =====================================================================

# ---------- Oracle Autonomous Database (ORDS, read-only) --------------
# [CONFIG] Base URL of the REST-enabled SUPPORT_RO schema, no trailing slash.
ORACLE_ORDS_BASE_URL=https://your-adb-id.adb.us-ashburn-1.oraclecloudapps.com/ords/support_ro
# [CREDENTIAL] "Basic Auth" credential named "Oracle ORDS SUPPORT_RO (Basic Auth)": User
ORACLE_ORDS_USER=SUPPORT_RO
# [CREDENTIAL] same credential: Password (the ro_password you set in oracle/ords-setup.sql)
ORACLE_ORDS_PASSWORD=
# Optional alternative to Basic Auth: OAuth2 client credentials printed by ords-setup.sql.
# [CREDENTIAL] "OAuth2 API" credential, grant type Client Credentials,
#              Access Token URL = ${ORACLE_ORDS_BASE_URL}/oauth/token
ORACLE_ORDS_OAUTH_CLIENT_ID=
ORACLE_ORDS_OAUTH_CLIENT_SECRET=
# [CONFIG] Hard timeout for every ORDS call (milliseconds).
ORACLE_LOOKUP_TIMEOUT_MS=4000

# ---------- Turso (libSQL over HTTP) ----------------------------------
# [CONFIG] From `turso db show <db> --url`. libsql:// is converted to https:// automatically.
TURSO_DATABASE_URL=https://your-db-your-org.turso.io
# [CREDENTIAL] "Bearer Auth" credential named "Turso Auth Token (Bearer)": Bearer Token
#              From `turso db tokens create <db>`.
TURSO_AUTH_TOKEN=

# ---------- Anthropic (Claude) ----------------------------------------
# [CREDENTIAL] "Header Auth" credential named "Anthropic API Key (x-api-key)":
#              Name = x-api-key, Value = the key
ANTHROPIC_API_KEY=
# [CONFIG] Model, reasoning effort and output cap.
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low
MAX_TOKENS=1024
# [CONFIG] "default" lets the API retry a refused request on a fallback model; "off" disables it.
CLAUDE_REFUSAL_FALLBACK=default

# ---------- Google AI Studio (Gemini) ---------------------------------
# [CREDENTIAL] "Query Auth" credential named "Google AI Studio Key (key)":
#              Name = key, Value = the key
GOOGLE_AI_API_KEY=
# [CONFIG] Any generateContent model id from AI Studio.
GEMINI_MODEL=gemini-flash-latest

# ---------- Slack ------------------------------------------------------
# [CREDENTIAL] "Slack API" credential named "Slack Bot (support alerts)":
#              Access Token = xoxb-... (scopes: chat:write; add chat:write.public
#              or invite the bot to the channel)
SLACK_BOT_TOKEN=
# [CONFIG] Channel ID (right-click channel -> View channel details -> bottom of the About tab).
SLACK_CHANNEL_ID=C0123456789

# ---------- IMAP (incoming email) --------------------------------------
# [CREDENTIAL] "IMAP" credential named "Support Mailbox (IMAP)"
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=support@example.com
IMAP_PASSWORD=
IMAP_SECURE=true

# ---------- SMTP (outgoing email) --------------------------------------
# [CREDENTIAL] "SMTP" credential named "Support Mailbox (SMTP)"
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=support@example.com
SMTP_PASSWORD=
SMTP_SECURE=true
# [CONFIG] The From/Reply-To address. Mail from this address is ignored (loop protection).
SUPPORT_FROM_EMAIL=support@example.com

# ---------- Chat widget / webhook -------------------------------------
# [CONFIG] Comma-separated origins allowed to use the chat, e.g.
#          https://shop.example.com,https://your-user.github.io   ("*" allows any).
WEBHOOK_ALLOWED_ORIGINS=*
# [WIDGET] Production webhook URL shown on the Chat Webhook node.
WEBHOOK_URL=https://your-n8n-host.example.com/webhook/support-chat
# [CONFIG] Time budget for a chat reply, including retries (milliseconds).
CHAT_TIMEOUT_MS=8000

# ---------- Behaviour --------------------------------------------------
# [CONFIG]
CONFIDENCE_THRESHOLD=0.8
COMPANY_NAME=Northwind Goods
SUPPORT_SIGNATURE="Best regards,\nThe Northwind Goods support team"
HISTORY_MESSAGE_LIMIT=10
FAQ_RESULT_LIMIT=5
MAX_MESSAGE_CHARS=4000
