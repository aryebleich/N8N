# =====================================================================
# Admin console environment. Copy to .env and fill in.
# Secrets for Anthropic, Google, Slack, ORDS, IMAP and SMTP are entered in
# the console (Integrations) and stored encrypted in Turso. The key
# fallbacks at the bottom are optional and only used when no key is saved.
# =====================================================================

# --- required ---------------------------------------------------------
# Public URL of this console (links in Slack and invite emails, Origin check).
APP_URL=https://support-admin.example.com
# Turso database shared with the n8n workflow (`turso db show <db> --url`). file:./data/dev.db works for local dev.
TURSO_DATABASE_URL=libsql://support-bot-yourorg.turso.io
# Turso token (`turso db tokens create <db>`). Not needed for file: URLs.
TURSO_AUTH_TOKEN=
# 32 random bytes, base64: openssl rand -base64 32. Losing it makes stored API keys unreadable.
ENCRYPTION_KEY=
# Shared secret n8n sends as X-Internal-Secret (at least 24 characters): openssl rand -hex 32
INTERNAL_API_SECRET=

# --- first owner (used by `npm run seed:owner`) -----------------------
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
OWNER_NAME=Owner
# Set to true once to reset an existing owner's password and role.
OWNER_RESET=false

# --- optional ---------------------------------------------------------
# Production chat webhook URL from the n8n Chat Webhook node (shown in Settings with a copy button).
N8N_CHAT_WEBHOOK_URL=https://your-n8n-host.example.com/webhook/support-chat
# Origins allowed to call the public widget endpoints (greeting, teammate replies). Comma-separated.
WIDGET_ALLOWED_ORIGINS=https://shop.example.com,https://your-user.github.io
# Bearer secret for /api/cron/retention (Vercel Cron sends it automatically when set). openssl rand -hex 24
CRON_SECRET=
# Session lifetime in hours (1-720).
SESSION_TTL_HOURS=12
# Trust X-Forwarded-For for client IPs (rate limits, audit log). Set false when not behind a proxy.
TRUST_PROXY=true

# --- optional key fallbacks (prefer saving keys under Integrations) ---
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
SLACK_BOT_TOKEN=
ORACLE_ORDS_PASSWORD=
IMAP_PASSWORD=
SMTP_PASSWORD=
