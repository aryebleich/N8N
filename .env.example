# =====================================================================
#  Support assistant admin panel: settings file
#
#  1. Copy this file and name the copy  .env   (same folder)
#  2. Fill in what you have. Everything is optional at first: the panel
#     starts with a local database and an offline simulator.
#  3. Restart the panel after every change to this file.
#
#  Keys stay in this file on the server. The panel never shows them and
#  never asks you to type them into the page; it only shows a green
#  "Connected" or red "Not connected" light for each service.
#  Never share this file or put it on GitHub (.gitignore already skips it).
# =====================================================================

# --- Safety -----------------------------------------------------------
# The panel has NO login. "false" means it only opens on this computer
# (http://localhost:3000). Only change to "true" after you have put your
# own login in front of it (VPN, hosting password, Cloudflare Access...).
ADMIN_PUBLIC=false

# The address you open the panel at. Used for links in Slack alerts and the chat widget.
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------
# Leave as is to keep everything in a file on this computer (data/support.db).
# To share the database with n8n, create a free Turso database and paste its URL
# (turso db show <name> --url) and a token (turso db tokens create <name>).
TURSO_DATABASE_URL=file:./data/support.db
TURSO_AUTH_TOKEN=

# --- n8n --------------------------------------------------------------
# A long random password that n8n sends with every call to this panel.
# Make one with:  openssl rand -hex 32   and put the SAME value in n8n.
INTERNAL_API_SECRET=
# The "Production URL" of the Chat Webhook node in n8n. Used in the chat widget code.
N8N_CHAT_WEBHOOK_URL=
# Where the chat widget script is hosted, and which websites may show it (comma-separated).
WIDGET_SCRIPT_URL=https://aryebleich.github.io/N8N/widget.js
WIDGET_ALLOWED_ORIGINS=https://www.yourshop.example

# --- AI ---------------------------------------------------------------
# Claude writes the answers. Key from console.anthropic.com → API Keys (starts with sk-ant-).
ANTHROPIC_API_KEY=
# Gemini double-checks them. Key from aistudio.google.com → Get API key (starts with AIza).
GOOGLE_AI_API_KEY=

# --- Slack (alerts when a person is needed) ---------------------------
# "Bot User OAuth Token" of your Slack app (starts with xoxb-). Needs the chat:write permission.
# Pick the channel on the Settings page.
SLACK_BOT_TOKEN=

# --- Email sending (replies you send from the panel) ------------------
# From your email provider's "SMTP" settings. Gmail: smtp.gmail.com, port 465, an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Optional: the "From" address. Otherwise the support address from Settings is used.
SMTP_FROM=

# --- Oracle (optional, read-only order lookups) -----------------------
# The ORDS address and the read-only SUPPORT_RO user from n8n/oracle/ords-setup.sql.
ORACLE_ORDS_URL=
ORACLE_ORDS_USER=SUPPORT_RO
ORACLE_ORDS_PASSWORD=
