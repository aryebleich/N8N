{
  "name": "support-assistant-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Easy no-login admin panel for the n8n Claude + Gemini customer support assistant",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/bundle-sql.mjs",
    "dev": "node scripts/start.mjs dev",
    "prebuild": "node scripts/bundle-sql.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "seed:generate": "tsx scripts/generate-seed.ts && node scripts/bundle-sql.mjs",
    "pretest": "node scripts/bundle-sql.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@libsql/client": "0.18.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
