{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npx -y npm@11.6.2 ci",
  "buildCommand": "npm run build",
  "crons": [{ "path": "/api/cron/retention", "schedule": "17 3 * * *" }],
  "functions": {
    "app/api/events/stream/route.ts": { "maxDuration": 60 },
    "app/api/internal/**/route.ts": { "maxDuration": 60 },
    "app/api/prompts/test/route.ts": { "maxDuration": 60 }
  }
}
